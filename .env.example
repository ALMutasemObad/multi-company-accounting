NODE_ENV=development
APP_NAME=النظام المحاسبي متعدد الشركات
VITE_APP_NAME=النظام المحاسبي متعدد الشركات
VITE_APP_SHORT_NAME=منصة المحاسبة
VITE_APP_MARK=م
PORT=3000
DATABASE_URL=mysql://mcap:change_me@127.0.0.1:3306/mcap_finance
WEB_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
PRE_AUTH_TTL_MINUTES=10
SESSION_TTL_HOURS=12
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
SELF_REGISTRATION_ENABLED=true
REGISTRATION_RATE_LIMIT_MAX=5
REGISTRATION_TOKEN_TTL_HOURS=24
# Development only. Production requires "resend", REGISTRATION_EMAIL_FROM and RESEND_API_KEY.
REGISTRATION_EMAIL_MODE=log
# Development/test only: explicit protected JSONL capture; never configure in production.
# REGISTRATION_EMAIL_CAPTURE_PATH=.local/registration-emails.jsonl
# REGISTRATION_EMAIL_FROM=accounts@example.com
# RESEND_API_KEY=re_replace_with_provider_key
# Production: generate a separate random value of at least 32 characters.
# REGISTRATION_AUDIT_PEPPER=replace_with_a_unique_random_secret
# Independent secret used to derive retry-stable verification tokens without storing them.
# REGISTRATION_TOKEN_SECRET=replace_with_another_unique_random_secret
# Uses the same mail transport and token secret with a separate HMAC domain.
PASSWORD_RESET_ENABLED=true
PASSWORD_RESET_RATE_LIMIT_MAX=5
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_LEASE_MS=30000
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BASE_BACKOFF_MS=1000
OUTBOX_HANDLER_TIMEOUT_MS=8000
OUTBOX_RETENTION_DAYS=30
READINESS_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000
LOG_REQUESTS=true
# Used only by the explicit development seed command; do not reuse in production.
SEED_ADMIN_PASSWORD=replace_with_a_long_development_password

# One-time company provisioning. Supply these as ephemeral environment variables;
# do not persist PROVISION_ADMIN_PASSWORD in a production .env file.
# PROVISION_ORGANIZATION_CODE=CLIENT_GROUP
# PROVISION_ORGANIZATION_NAME=مجموعة العميل
# PROVISION_COMPANY_CODE=COMPANY_001
# PROVISION_COMPANY_NAME=شركة العميل
# PROVISION_COMPANY_TIMEZONE=Asia/Riyadh
# PROVISION_BASE_CURRENCY_CODE=SAR
# PROVISION_ADMIN_EMAIL=admin@example.com
# PROVISION_ADMIN_DISPLAY_NAME=مدير الشركة
# PROVISION_ADMIN_PASSWORD=replace_with_a_unique_temporary_password
# PROVISION_CONFIRM=CREATE:CLIENT_GROUP/COMPANY_001
