{
  "name": "@mcap/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:db": "vitest run --no-file-parallelism",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:demo": "tsx prisma/demo-seed.ts",
    "database:verify-engine": "tsx src/platform/verify-database.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "^0.45.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "fflate": "0.8.3",
    "helmet": "8.3.0",
    "pdfkit": "^0.19.1",
    "read-excel-file": "9.3.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.1.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "7.2.1",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
