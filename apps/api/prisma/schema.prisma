  name                              String                             @db.VarChar(200)
  timezone                          String                             @db.VarChar(64)
  isActive                          Boolean                            @default(true) @map("is_active")
  manualJournalMakerCheckerEnabled  Boolean                            @default(true) @map("manual_journal_maker_checker_enabled")
  createdAt                         DateTime                           @default(now()) @map("created_at")
  updatedAt                         DateTime                           @updatedAt @map("updated_at")
  organization                      Organization                       @relation(fields: [organizationId], references: [id])
  baseCurrency                      Currency                           @relation("BaseCurrency", fields: [baseCurrencyId], references: [id])
  ownedCurrencies                   Currency[]                         @relation("OwnedCurrencies")
  itemSellingProfiles               SalesItemSellingProfile[]
  assignments                       UserCompany[]
  sessions                          Session[]
  idempotency                       IdempotencyRecord[]
  roles                             Role[]
  auditLogs                         AuditLog[]
  securityEvents                    SecurityEvent[]
  fiscalYears                       FiscalYear[]
  fiscalPeriods                     FiscalPeriod[]
  documentSequences                 DocumentSequence[]
  masterDataCodeSequences           MasterDataCodeSequence[]
  accountingDocuments               AccountingDocument[]
  journalEntries                    JournalEntry[]
  journalLines                      JournalLine[]
  accounts                          Account[]
  costCenters                       CostCenter[]
  customers                         Customer[]
  customerAddresses                 CustomerAddress[]
  cashBankAccounts                  CashBankAccount[]
  warehouses                        Warehouse[]
  unitsOfMeasure                    UnitOfMeasure[]
  inventoryItems                    InventoryItem[]
  inventoryItemBarcodes             InventoryItemBarcode[]
  inventoryMovementSequence         InventoryMovementSequence?
  inventoryMovements                InventoryMovement[]
  inventoryMovementLines            InventoryMovementLine[]
  inventoryBalances                 InventoryBalance[]
  inventoryValuationInitializations InventoryValuationInitialization[]
  paymentMethods                    PaymentMethod[]
  receipts                          Receipt[]
  receiptAllocations                ReceiptAllocation[]
  receivableItems                   ReceivableItem[]
  suppliers                         Supplier[]
  supplierAddresses                 SupplierAddress[]
  payments                          Payment[]
  paymentAllocations                PaymentAllocation[]
  payableItems                      PayableItem[]
  taxRates                          TaxRate[]
  salesInvoices                     SalesInvoice[]
  salesInvoiceLines                 SalesInvoiceLine[]
  purchaseInvoices                  PurchaseInvoice[]
  purchaseInvoiceLines              PurchaseInvoiceLine[]
  documentPrintArchives             DocumentPrintArchive[]
  companyCurrencies                 CompanyCurrency[]
  registrationRequests              RegistrationRequest[]              @relation("RegistrationCompany")
  dataImportBatches                 DataImportBatch[]
  bankStatementImports              BankStatementImport[]
  bankStatementLines                BankStatementLine[]
  bankReconciliationSessions        BankReconciliationSession[]
  bankReconciliationMatches         BankReconciliationMatch[]
  financialCloseRuns                FinancialCloseRun[]
  approvalRequests                  ApprovalRequest[]
  approvalDecisions                 ApprovalDecision[]
  cashFlowAccountMappings           CashFlowAccountMapping[]
  posSales                          PosSale[]
  professionalProjects              ProfessionalProject[]
  crmLeads                          CrmLead[]
  crmOpportunities                  CrmOpportunity[]
  crmActivities                     CrmActivity[]
  professionalProjectMembers        ProfessionalProjectMember[]
  professionalProjectAccessGrants   ProfessionalProjectAccessGrant[]
  professionalProjectStages         ProfessionalProjectStage[]
  professionalProjectTasks          ProfessionalProjectTask[]
  professionalTaskDependencies      ProfessionalTaskDependency[]
  professionalTimeEntries           ProfessionalTimeEntry[]
  professionalTimesheets            ProfessionalTimesheet[]
  professionalTimesheetSubmissions  ProfessionalTimesheetSubmission[]
  professionalServiceContracts      ProfessionalServiceContract[]
  professionalServiceRates          ProfessionalServiceRate[]
  professionalBillingRuns           ProfessionalBillingRun[]
  professionalBillingSourceLines    ProfessionalBillingSourceLine[]
  hrDepartments                     HrDepartment[]
  hrPositions                       HrPosition[]
  employees                         Employee[]
  employmentContracts               EmploymentContract[]
  platformBillingAccount            PlatformBillingAccount?
  platformBillingInvoices           PlatformBillingInvoice[]
  platformBillingInvoiceLines       PlatformBillingInvoiceLine[]
  platformBillingPayments           PlatformBillingPayment[]
  platformPaymentAttempts           PlatformPaymentAttempt[]
  platformCheckoutSessions          PlatformCheckoutSession[]
  platformPaymentTransitions        PlatformPaymentTransition[]
  platformWebhookReceipts           PlatformWebhookReceipt[]
  platformBillingRefunds            PlatformBillingRefund[]
