model User {
  id                                   BigInt                             @id @default(autoincrement()) @db.UnsignedBigInt
  emailNormalized                      String                             @unique @map("email_normalized") @db.VarChar(320)
  passwordHash                         String                             @map("password_hash") @db.VarChar(255)
  displayName                          String                             @map("display_name") @db.VarChar(160)
  nameEn                               String?                            @map("name_en") @db.VarChar(160)
  isActive                             Boolean                            @default(true) @map("is_active")
  failedLoginAttempts                  Int                                @default(0) @map("failed_login_attempts") @db.UnsignedTinyInt
  lockedUntil                          DateTime?                          @map("locked_until")
  lastLoginAt                          DateTime?                          @map("last_login_at")
  createdAt                            DateTime                           @default(now()) @map("created_at")
  updatedAt                            DateTime                           @updatedAt @map("updated_at")
  assignments                          UserCompany[]
  sessions                             Session[]
  idempotency                          IdempotencyRecord[]
  auditLogs                            AuditLog[]
  platformPlansCreated                 PlatformPlan[]                     @relation("PlatformPlanCreatedBy")
  platformPlansUpdated                 PlatformPlan[]                     @relation("PlatformPlanUpdatedBy")
  platformPlanVersionsCreated          PlatformPlanVersion[]              @relation("PlatformPlanVersionCreatedBy")
  platformPlanVersionsUpdated          PlatformPlanVersion[]              @relation("PlatformPlanVersionUpdatedBy")
  platformPlanVersionsPublished        PlatformPlanVersion[]              @relation("PlatformPlanVersionPublishedBy")
  securityEvents                       SecurityEvent[]                    @relation("SecurityEventUser")
  securityEventsAcknowledged           SecurityEvent[]                    @relation("SecurityEventAcknowledgedBy")
  periodsClosed                        FiscalPeriod[]                     @relation("PeriodClosedBy")
  periodsReopened                      FiscalPeriod[]                     @relation("PeriodReopenedBy")
  documentsCreated                     AccountingDocument[]               @relation("DocumentCreatedBy")
  documentsPosted                      AccountingDocument[]               @relation("DocumentPostedBy")
  printArchivesCreated                 DocumentPrintArchive[]             @relation("PrintArchiveCreatedBy")
  exchangeRatesUpdated                 CompanyExchangeRate[]              @relation("ExchangeRateUpdatedBy")
  registrationRequests                 RegistrationRequest[]              @relation("RegistrationUser")
  passwordResetRequests                PasswordResetRequest[]
  dataImportBatches                    DataImportBatch[]                  @relation("DataImportCreatedBy")
  inventoryMovementsCreated            InventoryMovement[]                @relation("InventoryMovementCreatedBy")
  inventoryValuationsCreated           InventoryValuationInitialization[] @relation("InventoryValuationCreatedBy")
  bankStatementImportsCreated          BankStatementImport[]              @relation("BankStatementImportCreatedBy")
  bankStatementLinesClassified         BankStatementLine[]                @relation("BankStatementLineClassifiedBy")
  bankReconciliationSessionsCreated    BankReconciliationSession[]        @relation("BankReconciliationSessionCreatedBy")
  bankReconciliationSessionsClosed     BankReconciliationSession[]        @relation("BankReconciliationSessionClosedBy")
  bankReconciliationMatchesApproved    BankReconciliationMatch[]          @relation("BankReconciliationMatchApprovedBy")
  bankReconciliationMatchesReleased    BankReconciliationMatch[]          @relation("BankReconciliationMatchReleasedBy")
  financialCloseRunsStarted            FinancialCloseRun[]                @relation("FinancialCloseRunStartedBy")
  financialCloseRunsReviewed           FinancialCloseRun[]                @relation("FinancialCloseRunReviewedBy")
  financialCloseRunsReturned           FinancialCloseRun[]                @relation("FinancialCloseRunReturnedBy")
  financialCloseRunsClosed             FinancialCloseRun[]                @relation("FinancialCloseRunClosedBy")
  approvalRequestsCreated              ApprovalRequest[]                  @relation("ApprovalRequestCreatedBy")
  approvalDecisionsMade                ApprovalDecision[]                 @relation("ApprovalDecisionMadeBy")
  cashFlowMappingsCreated              CashFlowAccountMapping[]           @relation("CashFlowMappingCreatedBy")
  cashFlowMappingsUpdated              CashFlowAccountMapping[]           @relation("CashFlowMappingUpdatedBy")
  posSalesCompleted                    PosSale[]                          @relation("PosSaleCompletedBy")
  professionalProjectsCreated          ProfessionalProject[]              @relation("ProfessionalProjectCreatedBy")
  professionalProjectsUpdated          ProfessionalProject[]              @relation("ProfessionalProjectUpdatedBy")
  crmLeadsCreated                      CrmLead[]                          @relation("CrmLeadCreatedBy")
  crmLeadsUpdated                      CrmLead[]                          @relation("CrmLeadUpdatedBy")
  crmOpportunitiesCreated              CrmOpportunity[]                   @relation("CrmOpportunityCreatedBy")
  crmOpportunitiesUpdated              CrmOpportunity[]                   @relation("CrmOpportunityUpdatedBy")
  crmActivitiesCreated                 CrmActivity[]                      @relation("CrmActivityCreatedBy")
  crmActivitiesUpdated                 CrmActivity[]                      @relation("CrmActivityUpdatedBy")
  professionalMembersAssigned          ProfessionalProjectMember[]        @relation("ProfessionalProjectMemberAssignedBy")
  professionalMembersUpdated           ProfessionalProjectMember[]        @relation("ProfessionalProjectMemberUpdatedBy")
  professionalAccessGrantsGranted      ProfessionalProjectAccessGrant[]   @relation("ProfessionalProjectAccessGrantGrantedBy")
  professionalAccessGrantsRevoked      ProfessionalProjectAccessGrant[]   @relation("ProfessionalProjectAccessGrantRevokedBy")
  professionalAccessGrantsUpdated      ProfessionalProjectAccessGrant[]   @relation("ProfessionalProjectAccessGrantUpdatedBy")
  hrDepartmentsCreated                 HrDepartment[]                     @relation("HrDepartmentCreatedBy")
  hrDepartmentsUpdated                 HrDepartment[]                     @relation("HrDepartmentUpdatedBy")
  hrPositionsCreated                   HrPosition[]                       @relation("HrPositionCreatedBy")
  hrPositionsUpdated                   HrPosition[]                       @relation("HrPositionUpdatedBy")
  employeesCreated                     Employee[]                         @relation("EmployeeCreatedBy")
  employeesUpdated                     Employee[]                         @relation("EmployeeUpdatedBy")
  employmentContractsCreated           EmploymentContract[]               @relation("EmploymentContractCreatedBy")
  employmentContractsUpdated           EmploymentContract[]               @relation("EmploymentContractUpdatedBy")
  employmentContractsEnded             EmploymentContract[]               @relation("EmploymentContractEndedBy")
  professionalTimesheetSubmissions     ProfessionalTimesheetSubmission[]  @relation("ProfessionalTimesheetSubmittedBy")
  professionalContractsCreated         ProfessionalServiceContract[]      @relation("ProfessionalContractCreatedBy")
  professionalContractsUpdated         ProfessionalServiceContract[]      @relation("ProfessionalContractUpdatedBy")
  professionalRatesCreated             ProfessionalServiceRate[]          @relation("ProfessionalRateCreatedBy")
  professionalRatesUpdated             ProfessionalServiceRate[]          @relation("ProfessionalRateUpdatedBy")
  professionalBillingRunsCreated       ProfessionalBillingRun[]           @relation("ProfessionalBillingRunCreatedBy")
  professionalStagesCreated            ProfessionalProjectStage[]         @relation("ProfessionalProjectStageCreatedBy")
  professionalStagesUpdated            ProfessionalProjectStage[]         @relation("ProfessionalProjectStageUpdatedBy")
  professionalTasksCreated             ProfessionalProjectTask[]          @relation("ProfessionalProjectTaskCreatedBy")
  professionalTasksUpdated             ProfessionalProjectTask[]          @relation("ProfessionalProjectTaskUpdatedBy")
  professionalDependenciesCreated      ProfessionalTaskDependency[]       @relation("ProfessionalTaskDependencyCreatedBy")
  professionalDependenciesUpdated      ProfessionalTaskDependency[]       @relation("ProfessionalTaskDependencyUpdatedBy")
  professionalDependenciesRemoved      ProfessionalTaskDependency[]       @relation("ProfessionalTaskDependencyRemovedBy")
  platformBillingAccountsCreated       PlatformBillingAccount[]           @relation("PlatformBillingAccountCreatedBy")
  platformBillingAccountsUpdated       PlatformBillingAccount[]           @relation("PlatformBillingAccountUpdatedBy")
  platformBillingInvoicesIssued        PlatformBillingInvoice[]           @relation("PlatformBillingInvoiceIssuedBy")
  platformBillingInvoicesVoided        PlatformBillingInvoice[]           @relation("PlatformBillingInvoiceVoidedBy")
  platformBillingPaymentsReceived      PlatformBillingPayment[]           @relation("PlatformBillingPaymentReceivedBy")
  platformPaymentAttemptsRequested     PlatformPaymentAttempt[]           @relation("PlatformPaymentAttemptRequestedBy")
  platformPaymentTransitionsActed      PlatformPaymentTransition[]        @relation("PlatformPaymentTransitionActor")
  platformBillingRefundsRequested      PlatformBillingRefund[]            @relation("PlatformBillingRefundRequestedBy")
  platformSubscriptionChangesRequested PlatformSubscriptionChange[]       @relation("PlatformSubscriptionChangeRequestedBy")
