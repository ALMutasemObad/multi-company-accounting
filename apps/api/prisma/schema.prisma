  salesInvoice   SalesInvoice @relation("PosSaleInvoice", fields: [salesInvoiceId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  receipt        Receipt      @relation("PosSaleReceipt", fields: [receiptId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  completedBy    User         @relation("PosSaleCompletedBy", fields: [completedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, companyId])
  @@unique([salesInvoiceId, companyId])
  @@unique([receiptId, companyId])
  @@index([companyId, completedAt, id])
  @@index([completedById, completedAt])
  @@map("pos_sales")
}

