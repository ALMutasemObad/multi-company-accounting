  dueDate                 DateTime           @map("due_date") @db.Date
  subtotal                Decimal            @db.Decimal(19, 4)
  discountTotal           Decimal            @map("discount_total") @db.Decimal(19, 4)
  taxableTotal            Decimal            @map("taxable_total") @db.Decimal(19, 4)
  taxTotal                Decimal            @map("tax_total") @db.Decimal(19, 4)
  total                   Decimal            @db.Decimal(19, 4)
  baseTotal               Decimal            @map("base_total") @db.Decimal(19, 4)
  customerNameSnapshot    String             @map("customer_name_snapshot") @db.VarChar(200)
  customerTaxLast4        String?            @map("customer_tax_last4") @db.VarChar(4)
  customerAddressSnapshot String?            @map("customer_address_snapshot") @db.VarChar(500)
  warehouseCodeSnapshot   String?            @map("warehouse_code_snapshot") @db.VarChar(40)
  warehouseNameSnapshot   String?            @map("warehouse_name_snapshot") @db.VarChar(160)
  notes                   String?            @db.VarChar(1000)
  company                 Company            @relation(fields: [companyId], references: [id])
  accountingDocument      AccountingDocument @relation(fields: [accountingDocumentId, companyId], references: [id, companyId])
  customer                Customer           @relation(fields: [customerId, companyId], references: [id, companyId])
  warehouse               Warehouse?         @relation(fields: [warehouseId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  sourceInvoice           SalesInvoice?      @relation("SalesCreditNotes", fields: [sourceInvoiceId, companyId], references: [id, companyId])
  creditNotes             SalesInvoice[]     @relation("SalesCreditNotes")
  arJournalLine           JournalLine?       @relation("SalesInvoiceArLine", fields: [arJournalLineId, companyId], references: [id, companyId])
