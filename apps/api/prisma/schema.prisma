  company                     Company             @relation(fields: [companyId], references: [id])
  accountingDocument          AccountingDocument  @relation(fields: [accountingDocumentId, companyId], references: [id, companyId])
  supplier                    Supplier?           @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  counterAccount              Account?            @relation("PaymentCounterAccount", fields: [counterAccountId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  cashBankAccount             CashBankAccount     @relation(fields: [cashBankAccountId, companyId], references: [id, companyId])
  paymentMethod               PaymentMethod       @relation(fields: [paymentMethodId], references: [id])
  currency                    Currency            @relation(fields: [currencyId], references: [id])
  allocations                 PaymentAllocation[]

  @@unique([id, companyId])
  @@unique([accountingDocumentId, companyId])
  @@index([companyId, supplierId])
  @@map("payments")
}

model PaymentAllocation {
  id                   BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  companyId            BigInt      @map("company_id") @db.UnsignedBigInt
  paymentId            BigInt      @map("payment_id") @db.UnsignedBigInt
  payableItemId        BigInt      @map("payable_item_id") @db.UnsignedBigInt
  allocatedAmount      Decimal     @map("allocated_amount") @db.Decimal(19, 4)
  carryingBaseAmount   Decimal?    @map("carrying_base_amount") @db.Decimal(19, 4)
  settlementBaseAmount Decimal?    @map("settlement_base_amount") @db.Decimal(19, 4)
  realizedFxBaseAmount Decimal?    @map("realized_fx_base_amount") @db.Decimal(19, 4)
  company              Company     @relation(fields: [companyId], references: [id])
  payment              Payment     @relation(fields: [paymentId, companyId], references: [id, companyId])
  payableItem          PayableItem @relation(fields: [payableItemId, companyId], references: [id, companyId])

  @@unique([paymentId, payableItemId])
  @@index([companyId, payableItemId])
  @@map("payment_allocations")
}

model RolePermission {
  roleId       BigInt     @map("role_id") @db.UnsignedBigInt
  permissionId BigInt     @map("permission_id") @db.UnsignedBigInt
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserCompanyRole {
  userId     BigInt      @map("user_id") @db.UnsignedBigInt
  companyId  BigInt      @map("company_id") @db.UnsignedBigInt
  roleId     BigInt      @map("role_id") @db.UnsignedBigInt
  createdAt  DateTime    @default(now()) @map("created_at")
  assignment UserCompany @relation(fields: [userId, companyId], references: [userId, companyId])
  role       Role        @relation(fields: [roleId, companyId], references: [id, companyId])

  @@id([userId, companyId, roleId])
  @@index([roleId])
  @@map("user_company_roles")
}

model Session {
  id                BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  tokenHash         Bytes        @unique @map("token_hash") @db.Binary(32)
  csrfHash          Bytes        @map("csrf_hash") @db.Binary(32)
  state             SessionState @map("session_state")
  userId            BigInt?      @map("user_id") @db.UnsignedBigInt
  selectedCompanyId BigInt?      @map("selected_company_id") @db.UnsignedBigInt
  authenticatedAt   DateTime?    @map("authenticated_at")
  expiresAt         DateTime     @map("expires_at")
  lastSeenAt        DateTime     @default(now()) @map("last_seen_at")
  revokedAt         DateTime?    @map("revoked_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  user              User?        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  selectedCompany   Company?     @relation(fields: [selectedCompanyId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, revokedAt, expiresAt])
  @@index([selectedCompanyId])
  @@map("sessions")
}

model IdempotencyRecord {
  id                 BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  companyId          BigInt            @map("company_id") @db.UnsignedBigInt
  userId             BigInt            @map("user_id") @db.UnsignedBigInt
  operation          String            @db.VarChar(100)
  keyHash            Bytes             @map("key_hash") @db.Binary(32)
  requestFingerprint Bytes             @map("request_fingerprint") @db.Binary(32)
  status             IdempotencyStatus
  responseStatus     Int?              @map("response_status") @db.UnsignedSmallInt
  responseBody       Json?             @map("response_body")
  expiresAt          DateTime          @map("expires_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  completedAt        DateTime?         @map("completed_at")
  company            Company           @relation(fields: [companyId], references: [id])
  user               User              @relation(fields: [userId], references: [id])

  @@unique([companyId, userId, operation, keyHash])
  @@index([expiresAt])
  @@map("idempotency_records")
}
