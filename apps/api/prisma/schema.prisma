  additionalRecurringFee Decimal?                    @map("additional_recurring_fee") @db.Decimal(19, 4)
  createdAt              DateTime                    @default(now()) @map("created_at")
  planVersion            PlatformPlanVersion         @relation(fields: [planVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  module                 PlatformModule              @relation(fields: [moduleId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([planVersionId, moduleId])
  @@index([moduleId, planVersionId])
  @@map("platform_plan_entitlements")
}

model PlatformSubscription {
  id                 BigInt                            @id @default(autoincrement()) @db.UnsignedBigInt
  companyId          BigInt                            @unique @map("company_id") @db.UnsignedBigInt
  planVersionId      BigInt                            @map("plan_version_id") @db.UnsignedBigInt
  status             PlatformSubscriptionStatus        @default(ACTIVE)
  startsAt           DateTime                          @map("starts_at")
  trialEndsAt        DateTime?                         @map("trial_ends_at")
  currentPeriodStart DateTime?                         @map("current_period_start") @db.Date
  currentPeriodEnd   DateTime?                         @map("current_period_end") @db.Date
  cancelAtPeriodEnd  Boolean                           @default(false) @map("cancel_at_period_end")
  version            Int                               @default(0) @db.UnsignedInt
  createdAt          DateTime                          @default(now()) @map("created_at")
  updatedAt          DateTime                          @updatedAt @map("updated_at")
  company            Company                           @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  planVersion        PlatformPlanVersion               @relation(fields: [planVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entitlements       PlatformSubscriptionEntitlement[]
  changes            PlatformSubscriptionChange[]
  billingInvoices    PlatformBillingInvoice[]

  @@unique([id, companyId])
  @@index([status, currentPeriodEnd, id])
  @@index([planVersionId, status])
  @@map("platform_subscriptions")
}

model PlatformSubscriptionEntitlement {
  id             BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  companyId      BigInt                    @map("company_id") @db.UnsignedBigInt
  subscriptionId BigInt                    @map("subscription_id") @db.UnsignedBigInt
  moduleId       BigInt                    @map("module_id") @db.UnsignedBigInt
  source         PlatformEntitlementSource
  effectiveFrom  DateTime                  @map("effective_from")
  effectiveUntil DateTime?                 @map("effective_until")
  reason         String                    @db.VarChar(500)
  createdAt      DateTime                  @default(now()) @map("created_at")
  company        Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subscription   PlatformSubscription      @relation(fields: [subscriptionId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  module         PlatformModule            @relation(fields: [moduleId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([subscriptionId, moduleId, effectiveFrom])
  @@unique([id, companyId])
  @@index([companyId, effectiveFrom, effectiveUntil, id])
  @@index([moduleId, effectiveFrom, effectiveUntil])
  @@map("platform_subscription_entitlements")
}

model PlatformSubscriptionChange {
  id                           BigInt                             @id @default(autoincrement()) @db.UnsignedBigInt
  publicId                     String                             @unique @default(uuid()) @map("public_id") @db.Char(36)
  companyId                    BigInt                             @map("company_id") @db.UnsignedBigInt
  subscriptionId               BigInt                             @map("subscription_id") @db.UnsignedBigInt
  fromPlanVersionId            BigInt?                            @map("from_plan_version_id") @db.UnsignedBigInt
  targetPlanVersionId          BigInt                             @map("target_plan_version_id") @db.UnsignedBigInt
  state                        PlatformSubscriptionChangeState
  source                       PlatformSubscriptionChangeSource
  requestedById                BigInt?                            @map("requested_by_id") @db.UnsignedBigInt
  decidedById                  BigInt?                            @map("decided_by_id") @db.UnsignedBigInt
  requestedSubscriptionVersion Int                                @map("requested_subscription_version") @db.UnsignedInt
  requestedAt                  DateTime                           @default(now()) @map("requested_at")
  effectiveAt                  DateTime?                          @map("effective_at")
  decidedAt                    DateTime?                          @map("decided_at")
  decisionReason               String?                            @map("decision_reason") @db.VarChar(500)
  currencyCode                 String                             @map("currency_code") @db.Char(3)
  baseRecurringFee             Decimal                            @map("base_recurring_fee") @db.Decimal(19, 4)
  optionalRecurringFee         Decimal                            @map("optional_recurring_fee") @db.Decimal(19, 4)
  totalRecurringFee            Decimal                            @map("total_recurring_fee") @db.Decimal(19, 4)
  createdAt                    DateTime                           @default(now()) @map("created_at")
  updatedAt                    DateTime                           @updatedAt @map("updated_at")
  company                      Company                            @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subscription                 PlatformSubscription               @relation(fields: [subscriptionId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  fromPlanVersion              PlatformPlanVersion?               @relation("PlatformSubscriptionChangeFromVersion", fields: [fromPlanVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetPlanVersion            PlatformPlanVersion                @relation("PlatformSubscriptionChangeTargetVersion", fields: [targetPlanVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestedBy                  User?                              @relation("PlatformSubscriptionChangeRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decidedBy                    User?                              @relation("PlatformSubscriptionChangeDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  modules                      PlatformSubscriptionChangeModule[]
  billingInvoices              PlatformBillingInvoice[]

  @@unique([id, companyId])
  @@index([companyId, state, effectiveAt, id], map: "platform_subscription_changes_company_state_effective_idx")
  @@index([subscriptionId, state, effectiveAt, id], map: "platform_subscription_changes_subscription_state_effective_idx")
  @@index([targetPlanVersionId, state, id], map: "platform_subscription_changes_target_state_idx")
  @@index([fromPlanVersionId], map: "platform_subscription_changes_from_version_idx")
  @@index([requestedById], map: "platform_subscription_changes_requested_by_idx")
  @@index([decidedById], map: "platform_subscription_changes_decided_by_idx")
  @@map("platform_subscription_changes")
}

model PlatformSubscriptionChangeModule {
  changeId      BigInt                      @map("change_id") @db.UnsignedBigInt
  moduleId      BigInt                      @map("module_id") @db.UnsignedBigInt
  selectionMode PlatformPlanModuleSelection @map("selection_mode")
  createdAt     DateTime                    @default(now()) @map("created_at")
  change        PlatformSubscriptionChange  @relation(fields: [changeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  module        PlatformModule              @relation(fields: [moduleId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([changeId, moduleId])
  @@index([moduleId, changeId], map: "platform_subscription_change_modules_module_idx")
  @@map("platform_subscription_change_modules")
}

model RolePermission {
  roleId       BigInt     @map("role_id") @db.UnsignedBigInt
  permissionId BigInt     @map("permission_id") @db.UnsignedBigInt
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserCompanyRole {
  userId     BigInt      @map("user_id") @db.UnsignedBigInt
  companyId  BigInt      @map("company_id") @db.UnsignedBigInt
  roleId     BigInt      @map("role_id") @db.UnsignedBigInt
  createdAt  DateTime    @default(now()) @map("created_at")
  assignment UserCompany @relation(fields: [userId, companyId], references: [userId, companyId])
  role       Role        @relation(fields: [roleId, companyId], references: [id, companyId])

  @@id([userId, companyId, roleId])
  @@index([roleId])
  @@map("user_company_roles")
}

model Session {
  id                BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  tokenHash         Bytes        @unique @map("token_hash") @db.Binary(32)
  csrfHash          Bytes        @map("csrf_hash") @db.Binary(32)
  state             SessionState @map("session_state")
  userId            BigInt?      @map("user_id") @db.UnsignedBigInt
  selectedCompanyId BigInt?      @map("selected_company_id") @db.UnsignedBigInt
  authenticatedAt   DateTime?    @map("authenticated_at")
  expiresAt         DateTime     @map("expires_at")
  lastSeenAt        DateTime     @default(now()) @map("last_seen_at")
  revokedAt         DateTime?    @map("revoked_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  user              User?        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  selectedCompany   Company?     @relation(fields: [selectedCompanyId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, revokedAt, expiresAt])
  @@index([selectedCompanyId])
  @@map("sessions")
}

model IdempotencyRecord {
  id                 BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  companyId          BigInt            @map("company_id") @db.UnsignedBigInt
  userId             BigInt            @map("user_id") @db.UnsignedBigInt
  operation          String            @db.VarChar(100)
  keyHash            Bytes             @map("key_hash") @db.Binary(32)
  requestFingerprint Bytes             @map("request_fingerprint") @db.Binary(32)
  status             IdempotencyStatus
  responseStatus     Int?              @map("response_status") @db.UnsignedSmallInt
  responseBody       Json?             @map("response_body")
  expiresAt          DateTime          @map("expires_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  completedAt        DateTime?         @map("completed_at")
  company            Company           @relation(fields: [companyId], references: [id])
  user               User              @relation(fields: [userId], references: [id])

  @@unique([companyId, userId, operation, keyHash])
  @@index([expiresAt])
  @@map("idempotency_records")
}
