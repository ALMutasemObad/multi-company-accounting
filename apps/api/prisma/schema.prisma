  companyId            BigInt                @map("company_id") @db.UnsignedBigInt
  outputTaxAccountId   BigInt?               @map("output_tax_account_id") @db.UnsignedBigInt
  inputTaxAccountId    BigInt?               @map("input_tax_account_id") @db.UnsignedBigInt
