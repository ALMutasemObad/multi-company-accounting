  companyId          BigInt           @map("company_id") @db.UnsignedBigInt
  inventoryBalanceId BigInt           @map("inventory_balance_id") @db.UnsignedBigInt
  quantitySnapshot   Decimal          @map("quantity_snapshot") @db.Decimal(19, 6)
  unitCostBase       Decimal          @map("unit_cost_base") @db.Decimal(19, 8)
  totalValueBase     Decimal          @map("total_value_base") @db.Decimal(19, 4)
  reason             String           @db.VarChar(500)
  createdById        BigInt           @map("created_by_id") @db.UnsignedBigInt
  createdAt          DateTime         @default(now()) @map("created_at")
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inventoryBalance   InventoryBalance @relation(fields: [inventoryBalanceId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  createdBy          User             @relation("InventoryValuationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, companyId])
  @@unique([inventoryBalanceId, companyId])
  @@index([companyId, createdAt])
  @@map("inventory_valuation_initializations")
}

model PaymentMethod {
  id                BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  companyId         BigInt?            @map("company_id") @db.UnsignedBigInt
  code              String             @unique @db.VarChar(40)
  nameAr            String             @map("name_ar") @db.VarChar(120)
  requiresReference Boolean            @default(false) @map("requires_reference")
  isActive          Boolean            @default(true) @map("is_active")
  version           Int                @default(0) @db.UnsignedInt
  scope             PaymentMethodScope @default(GLOBAL)
  company           Company?           @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  receipts          Receipt[]
  payments          Payment[]

  @@index([companyId, isActive])
  @@map("payment_methods")
}

model Receipt {
  id                          BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  companyId                   BigInt              @map("company_id") @db.UnsignedBigInt
  accountingDocumentId        BigInt              @unique @map("accounting_document_id") @db.UnsignedBigInt
  customerId                  BigInt?             @map("customer_id") @db.UnsignedBigInt
  counterAccountId            BigInt?             @map("counter_account_id") @db.UnsignedBigInt
  cashBankAccountId           BigInt              @map("cash_bank_account_id") @db.UnsignedBigInt
  paymentMethodId             BigInt              @map("payment_method_id") @db.UnsignedBigInt
  currencyId                  BigInt              @map("currency_id") @db.UnsignedBigInt
  exchangeRate                Decimal             @map("exchange_rate") @db.Decimal(19, 8)
  amount                      Decimal             @db.Decimal(19, 4)
  baseAmount                  Decimal             @map("base_amount") @db.Decimal(19, 4)
  referenceNumber             String?             @map("reference_number") @db.VarChar(100)
  counterpartyNameSnapshot    String              @map("counterparty_name_snapshot") @db.VarChar(200)
  counterpartyTaxLast4        String?             @map("counterparty_tax_last4") @db.VarChar(4)
  counterpartyAddressSnapshot String?             @map("counterparty_address_snapshot") @db.VarChar(500)
  notes                       String?             @db.VarChar(1000)
  company                     Company             @relation(fields: [companyId], references: [id])
  accountingDocument          AccountingDocument  @relation(fields: [accountingDocumentId, companyId], references: [id, companyId])
  customer                    Customer?           @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  counterAccount              Account?            @relation("ReceiptCounterAccount", fields: [counterAccountId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  cashBankAccount             CashBankAccount     @relation(fields: [cashBankAccountId, companyId], references: [id, companyId])
  paymentMethod               PaymentMethod       @relation(fields: [paymentMethodId], references: [id])
  currency                    Currency            @relation(fields: [currencyId], references: [id])
  allocations                 ReceiptAllocation[]
  posSale                     PosSale?            @relation("PosSaleReceipt")

  @@unique([id, companyId])
  @@unique([accountingDocumentId, companyId])
  @@index([companyId, customerId])
  @@map("receipts")
}

model ReceiptAllocation {
  id                   BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  companyId            BigInt         @map("company_id") @db.UnsignedBigInt
  receiptId            BigInt         @map("receipt_id") @db.UnsignedBigInt
  receivableItemId     BigInt         @map("receivable_item_id") @db.UnsignedBigInt
  allocatedAmount      Decimal        @map("allocated_amount") @db.Decimal(19, 4)
  carryingBaseAmount   Decimal?       @map("carrying_base_amount") @db.Decimal(19, 4)
  settlementBaseAmount Decimal?       @map("settlement_base_amount") @db.Decimal(19, 4)
  realizedFxBaseAmount Decimal?       @map("realized_fx_base_amount") @db.Decimal(19, 4)
  company              Company        @relation(fields: [companyId], references: [id])
  receipt              Receipt        @relation(fields: [receiptId, companyId], references: [id, companyId])
  receivableItem       ReceivableItem @relation(fields: [receivableItemId, companyId], references: [id, companyId])

  @@unique([receiptId, receivableItemId])
  @@index([companyId, receivableItemId])
  @@map("receipt_allocations")
}

model TaxRate {
