  @@map("users")
}

model RegistrationRequest {
  id                        BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  publicId                  String                     @unique @default(uuid()) @map("public_id") @db.VarChar(80)
  emailNormalized           String                     @unique @map("email_normalized") @db.VarChar(320)
  passwordHash              String?                    @map("password_hash") @db.VarChar(255)
  displayName               String                     @map("display_name") @db.VarChar(160)
  organizationName          String                     @map("organization_name") @db.VarChar(200)
  companyName               String                     @map("company_name") @db.VarChar(200)
  timezone                  String                     @db.VarChar(64)
  baseCurrencyCode          String                     @map("base_currency_code") @db.Char(3)
  locale                    String                     @default("ar") @db.VarChar(10)
  chartTemplateCode         String                     @default("SMALL_BUSINESS_GENERAL") @map("chart_template_code") @db.VarChar(80)
  verificationTokenHash     Bytes                      @unique @map("verification_token_hash") @db.Binary(32)
  verificationExpiresAt     DateTime                   @map("verification_expires_at")
  status                    RegistrationStatus         @default(PENDING_EMAIL)
  deliveryStatus            RegistrationDeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryAttempts          Int                        @default(0) @map("delivery_attempts") @db.UnsignedSmallInt
  deliveryGeneration        Int                        @default(1) @map("delivery_generation") @db.UnsignedSmallInt
  verifiedAt                DateTime?                  @map("verified_at")
  provisioningStartedAt     DateTime?                  @map("provisioning_started_at")
  completedAt               DateTime?                  @map("completed_at")
  provisionedOrganizationId BigInt?                    @map("provisioned_organization_id") @db.UnsignedBigInt
  provisionedCompanyId      BigInt?                    @map("provisioned_company_id") @db.UnsignedBigInt
  provisionedUserId         BigInt?                    @map("provisioned_user_id") @db.UnsignedBigInt
  lastErrorCode             String?                    @map("last_error_code") @db.VarChar(80)
  initialIpAddress          String?                    @map("initial_ip_address") @db.VarChar(64)
  initialUserAgent          String?                    @map("initial_user_agent") @db.VarChar(500)
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  provisionedOrganization   Organization?              @relation("RegistrationOrganization", fields: [provisionedOrganizationId], references: [id], onDelete: SetNull)
  provisionedCompany        Company?                   @relation("RegistrationCompany", fields: [provisionedCompanyId], references: [id], onDelete: SetNull)
  provisionedUser           User?                      @relation("RegistrationUser", fields: [provisionedUserId], references: [id], onDelete: SetNull)
  events                    RegistrationEvent[]

  @@index([status, verificationExpiresAt])
  @@index([provisionedCompanyId])
  @@index([provisionedUserId])
  @@map("registration_requests")
}

model RegistrationEvent {
  id                    BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  registrationRequestId BigInt?              @map("registration_request_id") @db.UnsignedBigInt
  emailHash             Bytes                @map("email_hash") @db.Binary(32)
  eventType             String               @map("event_type") @db.VarChar(80)
  severity              SecuritySeverity
  ipAddress             String?              @map("ip_address") @db.VarChar(64)
  userAgent             String?              @map("user_agent") @db.VarChar(500)
  details               Json?
  createdAt             DateTime             @default(now()) @map("created_at")
  registrationRequest   RegistrationRequest? @relation(fields: [registrationRequestId], references: [id], onDelete: Cascade)

  @@index([registrationRequestId, createdAt])
  @@index([emailHash, createdAt])
  @@index([severity, createdAt])
  @@map("registration_events")
}

model PasswordResetRequest {
  id                 BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  publicId           String                     @unique @default(uuid()) @map("public_id") @db.VarChar(80)
  userId             BigInt                     @map("user_id") @db.UnsignedBigInt
  locale             String                     @default("ar") @db.VarChar(10)
  tokenHash          Bytes?                     @unique @map("token_hash") @db.Binary(32)
  expiresAt          DateTime?                  @map("expires_at")
  status             PasswordResetStatus        @default(PENDING)
  deliveryStatus     RegistrationDeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryAttempts   Int                        @default(0) @map("delivery_attempts") @db.UnsignedSmallInt
  lastErrorCode      String?                    @map("last_error_code") @db.VarChar(80)
  requestedIpAddress String?                    @map("requested_ip_address") @db.VarChar(64)
  requestedUserAgent String?                    @map("requested_user_agent") @db.VarChar(500)
  usedAt             DateTime?                  @map("used_at")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  user               User                       @relation(fields: [userId], references: [id])

  @@index([userId, status, createdAt])
  @@index([status, expiresAt])
  @@map("password_reset_requests")
}

