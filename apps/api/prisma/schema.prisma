generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum SessionState {
  PRE_AUTH
  AUTHENTICATED
}

enum SecuritySeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

enum FiscalYearStatus {
  OPEN
  CLOSED
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
  REOPENED
}

enum AccountingDocumentType {
  MANUAL_JOURNAL
  RECEIPT
  PAYMENT
  PERIOD_CLOSE
  SALES_INVOICE
  SALES_CREDIT_NOTE
  PURCHASE_INVOICE
  PURCHASE_DEBIT_NOTE
}

enum AccountingDocumentStatus {
  DRAFT
  POSTED
  REVERSED
  CANCELLED
}

enum AccountClass {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum StatementSection {
  BALANCE_SHEET
  INCOME_STATEMENT
}

enum AddressType {
  LEGAL
  BILLING
  PAYMENT
  OTHER
}

enum CashBankAccountType {
  CASH
  BANK
}

enum PaymentMethodScope {
  GLOBAL
  COMPANY
}

enum CurrencyScope {
  GLOBAL
  COMPANY
}

enum RegistrationStatus {
  PENDING_EMAIL
  EMAIL_VERIFIED
  PROVISIONING
  COMPLETED
  REJECTED
}

enum RegistrationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model Organization {
  id                   BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  code                 String                @unique @default(uuid()) @db.VarChar(80)
  name                 String                @db.VarChar(200)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  companies            Company[]
  registrationRequests RegistrationRequest[] @relation("RegistrationOrganization")

  @@map("organizations")
}

model Currency {
  id                BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  code              String            @db.Char(3)
  nameAr            String            @map("name_ar") @db.VarChar(100)
  decimals          Int               @default(2) @db.UnsignedTinyInt
  isActive          Boolean           @default(true) @map("is_active")
  scope             CurrencyScope     @default(GLOBAL)
  scopeKey          String            @default("GLOBAL") @map("scope_key") @db.VarChar(40)
  ownerCompanyId    BigInt?           @map("owner_company_id") @db.UnsignedBigInt
  ownerCompany      Company?          @relation("OwnedCurrencies", fields: [ownerCompanyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  baseCompanies     Company[]         @relation("BaseCurrency")
  journalLines      JournalLine[]
  receipts          Receipt[]
  payments          Payment[]
  salesInvoices     SalesInvoice[]
  purchaseInvoices  PurchaseInvoice[]
  companyCurrencies CompanyCurrency[]

  @@unique([scopeKey, code])
  @@index([ownerCompanyId, isActive])
  @@map("currencies")
}

model Company {
  id                               BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId                   BigInt                 @map("organization_id") @db.UnsignedBigInt
  baseCurrencyId                   BigInt                 @map("base_currency_id") @db.UnsignedBigInt
  code                             String                 @default(uuid()) @db.VarChar(80)
  name                             String                 @db.VarChar(200)
  timezone                         String                 @db.VarChar(64)
  isActive                         Boolean                @default(true) @map("is_active")
  manualJournalMakerCheckerEnabled Boolean                @default(true) @map("manual_journal_maker_checker_enabled")
  createdAt                        DateTime               @default(now()) @map("created_at")
  updatedAt                        DateTime               @updatedAt @map("updated_at")
  organization                     Organization           @relation(fields: [organizationId], references: [id])
  baseCurrency                     Currency               @relation("BaseCurrency", fields: [baseCurrencyId], references: [id])
  ownedCurrencies                  Currency[]             @relation("OwnedCurrencies")
  assignments                      UserCompany[]
  sessions                         Session[]
  idempotency                      IdempotencyRecord[]
  roles                            Role[]
  auditLogs                        AuditLog[]
  securityEvents                   SecurityEvent[]
  fiscalYears                      FiscalYear[]
  fiscalPeriods                    FiscalPeriod[]
  documentSequences                DocumentSequence[]
  accountingDocuments              AccountingDocument[]
  journalEntries                   JournalEntry[]
  journalLines                     JournalLine[]
  accounts                         Account[]
  costCenters                      CostCenter[]
  customers                        Customer[]
  customerAddresses                CustomerAddress[]
  cashBankAccounts                 CashBankAccount[]
  paymentMethods                   PaymentMethod[]
  receipts                         Receipt[]
  receiptAllocations               ReceiptAllocation[]
  suppliers                        Supplier[]
  supplierAddresses                SupplierAddress[]
  payments                         Payment[]
  paymentAllocations               PaymentAllocation[]
  taxRates                         TaxRate[]
  salesInvoices                    SalesInvoice[]
  salesInvoiceLines                SalesInvoiceLine[]
  purchaseInvoices                 PurchaseInvoice[]
  purchaseInvoiceLines             PurchaseInvoiceLine[]
  documentPrintArchives            DocumentPrintArchive[]
  companyCurrencies                CompanyCurrency[]
  registrationRequests             RegistrationRequest[]  @relation("RegistrationCompany")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("companies")
}

model User {
  id                         BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  emailNormalized            String                 @unique @map("email_normalized") @db.VarChar(320)
  passwordHash               String                 @map("password_hash") @db.VarChar(255)
  displayName                String                 @map("display_name") @db.VarChar(160)
  nameEn                     String?                @map("name_en") @db.VarChar(160)
  isActive                   Boolean                @default(true) @map("is_active")
  failedLoginAttempts        Int                    @default(0) @map("failed_login_attempts") @db.UnsignedTinyInt
  lockedUntil                DateTime?              @map("locked_until")
  lastLoginAt                DateTime?              @map("last_login_at")
  createdAt                  DateTime               @default(now()) @map("created_at")
  updatedAt                  DateTime               @updatedAt @map("updated_at")
  assignments                UserCompany[]
  sessions                   Session[]
  idempotency                IdempotencyRecord[]
  auditLogs                  AuditLog[]
  securityEvents             SecurityEvent[]        @relation("SecurityEventUser")
  securityEventsAcknowledged SecurityEvent[]        @relation("SecurityEventAcknowledgedBy")
  periodsClosed              FiscalPeriod[]         @relation("PeriodClosedBy")
  periodsReopened            FiscalPeriod[]         @relation("PeriodReopenedBy")
  documentsCreated           AccountingDocument[]   @relation("DocumentCreatedBy")
  documentsPosted            AccountingDocument[]   @relation("DocumentPostedBy")
  printArchivesCreated       DocumentPrintArchive[] @relation("PrintArchiveCreatedBy")
  exchangeRatesUpdated       CompanyExchangeRate[]  @relation("ExchangeRateUpdatedBy")
  registrationRequests       RegistrationRequest[]  @relation("RegistrationUser")

  @@map("users")
}

model RegistrationRequest {
  id                        BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  publicId                  String                     @unique @default(uuid()) @map("public_id") @db.VarChar(80)
  emailNormalized           String                     @unique @map("email_normalized") @db.VarChar(320)
  passwordHash              String?                    @map("password_hash") @db.VarChar(255)
  displayName               String                     @map("display_name") @db.VarChar(160)
  organizationName          String                     @map("organization_name") @db.VarChar(200)
  companyName               String                     @map("company_name") @db.VarChar(200)
  timezone                  String                     @db.VarChar(64)
  baseCurrencyCode          String                     @map("base_currency_code") @db.Char(3)
  locale                    String                     @default("ar") @db.VarChar(10)
  chartTemplateCode         String                     @default("SMALL_BUSINESS_GENERAL") @map("chart_template_code") @db.VarChar(80)
  verificationTokenHash     Bytes                      @unique @map("verification_token_hash") @db.Binary(32)
  verificationExpiresAt     DateTime                   @map("verification_expires_at")
  status                    RegistrationStatus         @default(PENDING_EMAIL)
  deliveryStatus            RegistrationDeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryAttempts          Int                        @default(0) @map("delivery_attempts") @db.UnsignedSmallInt
  deliveryGeneration        Int                        @default(1) @map("delivery_generation") @db.UnsignedSmallInt
  verifiedAt                DateTime?                  @map("verified_at")
  provisioningStartedAt     DateTime?                  @map("provisioning_started_at")
  completedAt               DateTime?                  @map("completed_at")
  provisionedOrganizationId BigInt?                    @map("provisioned_organization_id") @db.UnsignedBigInt
  provisionedCompanyId      BigInt?                    @map("provisioned_company_id") @db.UnsignedBigInt
  provisionedUserId         BigInt?                    @map("provisioned_user_id") @db.UnsignedBigInt
  lastErrorCode             String?                    @map("last_error_code") @db.VarChar(80)
  initialIpAddress          String?                    @map("initial_ip_address") @db.VarChar(64)
  initialUserAgent          String?                    @map("initial_user_agent") @db.VarChar(500)
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  provisionedOrganization   Organization?              @relation("RegistrationOrganization", fields: [provisionedOrganizationId], references: [id], onDelete: SetNull)
  provisionedCompany        Company?                   @relation("RegistrationCompany", fields: [provisionedCompanyId], references: [id], onDelete: SetNull)
  provisionedUser           User?                      @relation("RegistrationUser", fields: [provisionedUserId], references: [id], onDelete: SetNull)
  events                    RegistrationEvent[]

  @@index([status, verificationExpiresAt])
  @@index([provisionedCompanyId])
  @@index([provisionedUserId])
  @@map("registration_requests")
}

model RegistrationEvent {
  id                    BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  registrationRequestId BigInt?              @map("registration_request_id") @db.UnsignedBigInt
  emailHash             Bytes                @map("email_hash") @db.Binary(32)
  eventType             String               @map("event_type") @db.VarChar(80)
  severity              SecuritySeverity
  ipAddress             String?              @map("ip_address") @db.VarChar(64)
  userAgent             String?              @map("user_agent") @db.VarChar(500)
  details               Json?
  createdAt             DateTime             @default(now()) @map("created_at")
  registrationRequest   RegistrationRequest? @relation(fields: [registrationRequestId], references: [id], onDelete: Cascade)

  @@index([registrationRequestId, createdAt])
  @@index([emailHash, createdAt])
  @@index([severity, createdAt])
  @@map("registration_events")
}

model OutboxEvent {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  eventId        String       @unique @default(uuid()) @map("event_id") @db.Char(36)
  eventType      String       @map("event_type") @db.VarChar(100)
  schemaVersion  Int          @default(1) @map("schema_version") @db.UnsignedSmallInt
  aggregateType  String       @map("aggregate_type") @db.VarChar(80)
  aggregateId    String       @map("aggregate_id") @db.VarChar(80)
  companyId      BigInt?      @map("company_id") @db.UnsignedBigInt
  payload        Json
  occurredAt     DateTime     @default(now()) @map("occurred_at")
  status         OutboxStatus @default(PENDING)
  availableAt    DateTime     @default(now()) @map("available_at")
  attemptCount   Int          @default(0) @map("attempt_count") @db.UnsignedSmallInt
  maxAttempts    Int          @default(8) @map("max_attempts") @db.UnsignedSmallInt
  lockedAt       DateTime?    @map("locked_at")
  lockToken      String?      @map("lock_token") @db.Char(36)
  lastErrorCode  String?      @map("last_error_code") @db.VarChar(80)
  lastErrorAt    DateTime?    @map("last_error_at")
  processedAt    DateTime?    @map("processed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([status, availableAt, id])
  @@index([status, lockedAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([processedAt])
  @@map("outbox_events")
}

model CompanyCurrency {
  companyId  BigInt                @map("company_id") @db.UnsignedBigInt
  currencyId BigInt                @map("currency_id") @db.UnsignedBigInt
  isActive   Boolean               @default(true) @map("is_active")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  company    Company               @relation(fields: [companyId], references: [id])
  currency   Currency              @relation(fields: [currencyId], references: [id])
  rates      CompanyExchangeRate[]

  @@id([companyId, currencyId])
  @@index([currencyId])
  @@map("company_currencies")
}

model CompanyExchangeRate {
  id              BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  companyId       BigInt          @map("company_id") @db.UnsignedBigInt
  currencyId      BigInt          @map("currency_id") @db.UnsignedBigInt
  rateDate        DateTime        @map("rate_date") @db.Date
  rate            Decimal         @db.Decimal(19, 8)
  source          String?         @db.VarChar(100)
  updatedById     BigInt          @map("updated_by_id") @db.UnsignedBigInt
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  companyCurrency CompanyCurrency @relation(fields: [companyId, currencyId], references: [companyId, currencyId])
  updatedBy       User            @relation("ExchangeRateUpdatedBy", fields: [updatedById], references: [id])

  @@unique([companyId, currencyId, rateDate])
  @@index([updatedById])
  @@index([companyId, rateDate])
  @@map("company_exchange_rates")
}

model UserCompany {
  userId    BigInt            @map("user_id") @db.UnsignedBigInt
  companyId BigInt            @map("company_id") @db.UnsignedBigInt
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")
  user      User              @relation(fields: [userId], references: [id])
  company   Company           @relation(fields: [companyId], references: [id])
  roles     UserCompanyRole[]

  @@id([userId, companyId])
  @@index([companyId])
  @@map("user_companies")
}

model Role {
  id           BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  companyId    BigInt            @map("company_id") @db.UnsignedBigInt
  code         String            @db.VarChar(80)
  nameAr       String            @map("name_ar") @db.VarChar(120)
  nameEn       String?           @map("name_en") @db.VarChar(120)
  isSystemRole Boolean           @default(false) @map("is_system_role")
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")
  company      Company           @relation(fields: [companyId], references: [id])
  permissions  RolePermission[]
  assignments  UserCompanyRole[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@map("roles")
}

model Permission {
  id            BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  code          String           @unique @db.VarChar(120)
  module        String           @db.VarChar(80)
  descriptionAr String           @map("description_ar") @db.VarChar(255)
  roles         RolePermission[]

  @@map("permissions")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  companyId   BigInt   @map("company_id") @db.UnsignedBigInt
  actorUserId BigInt   @map("actor_user_id") @db.UnsignedBigInt
  action      String   @db.VarChar(120)
  entityType  String   @map("entity_type") @db.VarChar(80)
  entityId    String   @map("entity_id") @db.VarChar(64)
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at")
  company     Company  @relation(fields: [companyId], references: [id])
  actor       User     @relation(fields: [actorUserId], references: [id])

  @@index([companyId, createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}

model SecurityEvent {
  id               BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  companyId        BigInt           @map("company_id") @db.UnsignedBigInt
  userId           BigInt?          @map("user_id") @db.UnsignedBigInt
  sessionId        BigInt?          @map("session_id") @db.UnsignedBigInt
  eventType        String           @map("event_type") @db.VarChar(80)
  severity         SecuritySeverity
  emailSnapshot    String?          @map("email_snapshot") @db.VarChar(320)
  ipAddress        String?          @map("ip_address") @db.VarChar(64)
  userAgent        String?          @map("user_agent") @db.VarChar(500)
  details          Json?
  acknowledgedAt   DateTime?        @map("acknowledged_at")
  acknowledgedById BigInt?          @map("acknowledged_by_id") @db.UnsignedBigInt
  createdAt        DateTime         @default(now()) @map("created_at")
  company          Company          @relation(fields: [companyId], references: [id])
  user             User?            @relation("SecurityEventUser", fields: [userId], references: [id])
  acknowledgedBy   User?            @relation("SecurityEventAcknowledgedBy", fields: [acknowledgedById], references: [id])

  @@index([companyId, createdAt])
  @@index([companyId, severity, acknowledgedAt])
  @@index([userId, createdAt])
  @@index([sessionId])
  @@map("security_events")
}

model FiscalYear {
  id        BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  companyId BigInt             @map("company_id") @db.UnsignedBigInt
  name      String             @db.VarChar(80)
  startDate DateTime           @map("start_date") @db.Date
  endDate   DateTime           @map("end_date") @db.Date
  status    FiscalYearStatus   @default(OPEN)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  company   Company            @relation(fields: [companyId], references: [id])
  periods   FiscalPeriod[]
  sequences DocumentSequence[]

  @@unique([companyId, name])
  @@unique([id, companyId])
  @@index([companyId, startDate, endDate])
  @@map("fiscal_years")
}

model FiscalPeriod {
  id             BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  companyId      BigInt               @map("company_id") @db.UnsignedBigInt
  fiscalYearId   BigInt               @map("fiscal_year_id") @db.UnsignedBigInt
  periodNumber   Int                  @map("period_number") @db.UnsignedTinyInt
  name           String               @db.VarChar(80)
  startDate      DateTime             @map("start_date") @db.Date
  endDate        DateTime             @map("end_date") @db.Date
  status         FiscalPeriodStatus   @default(OPEN)
  closedBy       BigInt?              @map("closed_by") @db.UnsignedBigInt
  closedAt       DateTime?            @map("closed_at")
  reopenedBy     BigInt?              @map("reopened_by") @db.UnsignedBigInt
  reopenedAt     DateTime?            @map("reopened_at")
  reopenReason   String?              @map("reopen_reason") @db.VarChar(500)
  version        Int                  @default(0) @db.UnsignedInt
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  company        Company              @relation(fields: [companyId], references: [id])
  fiscalYear     FiscalYear           @relation(fields: [fiscalYearId, companyId], references: [id, companyId])
  closedByUser   User?                @relation("PeriodClosedBy", fields: [closedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reopenedByUser User?                @relation("PeriodReopenedBy", fields: [reopenedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  documents      AccountingDocument[]

  @@unique([fiscalYearId, periodNumber])
  @@unique([id, companyId])
  @@index([companyId, startDate, endDate])
  @@map("fiscal_periods")
}

model DocumentSequence {
  id           BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  companyId    BigInt     @map("company_id") @db.UnsignedBigInt
  fiscalYearId BigInt     @map("fiscal_year_id") @db.UnsignedBigInt
  documentType String     @map("document_type") @db.VarChar(40)
  prefix       String     @db.VarChar(20)
  nextNumber   BigInt     @default(1) @map("next_number") @db.UnsignedBigInt
  padding      Int        @default(6) @db.UnsignedTinyInt
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  company      Company    @relation(fields: [companyId], references: [id])
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId, companyId], references: [id, companyId])

  @@unique([fiscalYearId, documentType])
  @@unique([companyId, documentType, prefix])
  @@index([companyId, fiscalYearId])
  @@map("document_sequences")
}

model AccountingDocument {
  id                   BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  companyId            BigInt                   @map("company_id") @db.UnsignedBigInt
  fiscalPeriodId       BigInt                   @map("fiscal_period_id") @db.UnsignedBigInt
  documentType         AccountingDocumentType   @map("document_type")
  documentNumber       String                   @map("document_number") @db.VarChar(60)
  documentDate         DateTime                 @map("document_date") @db.Date
  description          String                   @db.VarChar(500)
  status               AccountingDocumentStatus @default(DRAFT)
  createdBy            BigInt                   @map("created_by") @db.UnsignedBigInt
  postedBy             BigInt?                  @map("posted_by") @db.UnsignedBigInt
  postedAt             DateTime?                @map("posted_at")
  reversedByDocumentId BigInt?                  @map("reversed_by_document_id") @db.UnsignedBigInt
  version              Int                      @default(0) @db.UnsignedInt
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  company              Company                  @relation(fields: [companyId], references: [id])
  fiscalPeriod         FiscalPeriod             @relation(fields: [fiscalPeriodId, companyId], references: [id, companyId])
  creator              User                     @relation("DocumentCreatedBy", fields: [createdBy], references: [id])
  poster               User?                    @relation("DocumentPostedBy", fields: [postedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reversedByDocument   AccountingDocument?      @relation("DocumentReversal", fields: [reversedByDocumentId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  reversesDocument     AccountingDocument?      @relation("DocumentReversal")
  journalEntries       JournalEntry[]
  receipt              Receipt?
  payment              Payment?
  salesInvoice         SalesInvoice?
  purchaseInvoice      PurchaseInvoice?
  printArchive         DocumentPrintArchive?

  @@unique([companyId, documentType, documentNumber])
  @@unique([id, companyId])
  @@unique([reversedByDocumentId, companyId])
  @@index([companyId, documentDate, status])
  @@index([fiscalPeriodId, status])
  @@map("accounting_documents")
}

model DocumentPrintArchive {
  id                   BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  companyId            BigInt             @map("company_id") @db.UnsignedBigInt
  accountingDocumentId BigInt             @unique @map("accounting_document_id") @db.UnsignedBigInt
  formatVersion        Int                @default(1) @map("format_version") @db.UnsignedSmallInt
  snapshot             Json
  snapshotHash         String             @map("snapshot_hash") @db.Char(64)
  createdBy            BigInt             @map("created_by") @db.UnsignedBigInt
  printCount           Int                @default(0) @map("print_count") @db.UnsignedInt
  firstPrintedAt       DateTime?          @map("first_printed_at")
  lastPrintedAt        DateTime?          @map("last_printed_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  company              Company            @relation(fields: [companyId], references: [id])
  accountingDocument   AccountingDocument @relation(fields: [accountingDocumentId, companyId], references: [id, companyId])
  creator              User               @relation("PrintArchiveCreatedBy", fields: [createdBy], references: [id])

  @@unique([id, companyId])
  @@unique([accountingDocumentId, companyId])
  @@index([companyId, createdAt])
  @@map("document_print_archives")
}

model JournalEntry {
  id                       BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  companyId                BigInt             @map("company_id") @db.UnsignedBigInt
  accountingDocumentId     BigInt             @map("accounting_document_id") @db.UnsignedBigInt
  entryNumber              Int                @map("entry_number") @db.UnsignedSmallInt
  entryDate                DateTime           @map("entry_date") @db.Date
  description              String             @db.VarChar(500)
  reversalOfJournalEntryId BigInt?            @map("reversal_of_journal_entry_id") @db.UnsignedBigInt
  createdAt                DateTime           @default(now()) @map("created_at")
  company                  Company            @relation(fields: [companyId], references: [id])
  accountingDocument       AccountingDocument @relation(fields: [accountingDocumentId, companyId], references: [id, companyId])
  reversalOf               JournalEntry?      @relation("JournalEntryReversal", fields: [reversalOfJournalEntryId, companyId], references: [id, companyId])
  reversedBy               JournalEntry?      @relation("JournalEntryReversal")
  lines                    JournalLine[]

  @@unique([accountingDocumentId, entryNumber])
  @@unique([id, companyId])
  @@unique([reversalOfJournalEntryId, companyId])
  @@index([companyId, entryDate])
  @@map("journal_entries")
}

model JournalLine {
  id                 BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  companyId          BigInt              @map("company_id") @db.UnsignedBigInt
  journalEntryId     BigInt              @map("journal_entry_id") @db.UnsignedBigInt
  lineNumber         Int                 @map("line_number") @db.UnsignedSmallInt
