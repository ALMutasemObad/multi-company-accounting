  @@unique([arJournalLineId, companyId])
  @@index([companyId, customerId, dueDate])
  @@index([companyId, warehouseId])
  @@index([sourceInvoiceId, companyId])
  @@map("sales_invoices")
}

model PosSale {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  companyId      BigInt       @map("company_id") @db.UnsignedBigInt
  salesInvoiceId BigInt       @unique @map("sales_invoice_id") @db.UnsignedBigInt
