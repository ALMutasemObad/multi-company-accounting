generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum SessionState {
  PRE_AUTH
  AUTHENTICATED
}

enum SecuritySeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

enum FiscalYearStatus {
  OPEN
  CLOSED
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
  REOPENED
}

enum FinancialCloseRunStatus {
  PREPARING
  AWAITING_APPROVAL
  REVIEWED
  CLOSED
}

enum ApprovalSubjectType {
  FINANCIAL_CLOSE_RUN
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalDecisionType {
  APPROVE
  REJECT
}

enum CashFlowMappingClassification {
  NET_INCOME
  OPERATING_ADJUSTMENT
  OPERATING_WORKING_CAPITAL
  INVESTING
  FINANCING
  EXCLUDED
}

enum AccountingDocumentType {
  MANUAL_JOURNAL
  INVENTORY_ADJUSTMENT
  RECEIPT
  PAYMENT
  PERIOD_CLOSE
  SALES_INVOICE
  SALES_CREDIT_NOTE
  PURCHASE_INVOICE
  PURCHASE_DEBIT_NOTE
}

enum AccountingDocumentStatus {
  DRAFT
  POSTED
  REVERSED
  CANCELLED
}

enum SettlementItemStatus {
  OPEN
  PARTIAL
  SETTLED
  REVERSED
}

enum AccountClass {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum StatementSection {
  BALANCE_SHEET
  INCOME_STATEMENT
}

enum AddressType {
  LEGAL
  BILLING
  PAYMENT
  OTHER
}

enum CashBankAccountType {
  CASH
  BANK
}

enum PaymentMethodScope {
  GLOBAL
  COMPANY
}

enum CurrencyScope {
  GLOBAL
  COMPANY
}

enum RegistrationStatus {
  PENDING_EMAIL
  EMAIL_VERIFIED
  PROVISIONING
  COMPLETED
  REJECTED
}

enum RegistrationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum PasswordResetStatus {
  PENDING
  USED
  REVOKED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum DataImportType {
  CUSTOMERS
  SUPPLIERS
  SALES_INVOICES
  PURCHASE_INVOICES
}

enum DataImportFormat {
  CSV
  XLSX
}

enum DataImportStatus {
  PREVIEWED
  COMMITTED
  EXPIRED
}

enum InventoryMovementType {
  OPENING_BALANCE
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum InventoryMovementSourceType {
  SALES_INVOICE
  SALES_CREDIT_NOTE
  PURCHASE_INVOICE
  PURCHASE_DEBIT_NOTE
}

enum InventoryMovementSourceEvent {
  POST
  REVERSE
}

enum InventoryMovementStatus {
  POSTED
  REVERSED
}

enum BankStatementFormat {
  CSV
  CAMT053
}

enum BankStatementImportStatus {
  COMMITTED
  CANCELLED
}

enum BankStatementLineClassification {
  PENDING_TRANSACTION
  BANK_FEE
  BANK_INTEREST
  BANK_ERROR
  NEEDS_ACCOUNTING_DOCUMENT
}

enum BankReconciliationSessionStatus {
  OPEN
  CLOSED
}

enum BankReconciliationMatchStatus {
  PROPOSED
  APPROVED
  RELEASED
}

enum BankReconciliationMatchSource {
  SUGGESTED
  MANUAL
}

enum BankReconciliationMatchRule {
  EXACT_REFERENCE_AMOUNT_CURRENCY
  EXACT_AMOUNT_CURRENCY_DATE
  MANUAL
}

enum ProfessionalProjectKind {
  LEGAL_MATTER
  CONSULTING_ENGAGEMENT
  PROFESSIONAL_PROJECT
}

enum ProfessionalProjectBillingModel {
  TIME_AND_MATERIALS
  FIXED_FEE
  NON_BILLABLE
}

enum ProfessionalProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProfessionalProjectMemberRole {
  MANAGER
  PROFESSIONAL
  REVIEWER
}

model Organization {
  id                   BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  code                 String                @unique @default(uuid()) @db.VarChar(80)
  name                 String                @db.VarChar(200)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  companies            Company[]
  registrationRequests RegistrationRequest[] @relation("RegistrationOrganization")

  @@map("organizations")
}

model Currency {
  id                BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  code              String            @db.Char(3)
  nameAr            String            @map("name_ar") @db.VarChar(100)
  decimals          Int               @default(2) @db.UnsignedTinyInt
  isActive          Boolean           @default(true) @map("is_active")
  scope             CurrencyScope     @default(GLOBAL)
  scopeKey          String            @default("GLOBAL") @map("scope_key") @db.VarChar(40)
  ownerCompanyId    BigInt?           @map("owner_company_id") @db.UnsignedBigInt
  ownerCompany      Company?          @relation("OwnedCurrencies", fields: [ownerCompanyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  baseCompanies     Company[]         @relation("BaseCurrency")
  journalLines      JournalLine[]
  receipts          Receipt[]
  payments          Payment[]
  salesInvoices     SalesInvoice[]
  purchaseInvoices  PurchaseInvoice[]
  receivableItems   ReceivableItem[]
  payableItems      PayableItem[]
  companyCurrencies CompanyCurrency[]

  @@unique([scopeKey, code])
  @@index([ownerCompanyId, isActive])
  @@map("currencies")
}

model Company {
  id                                BigInt                             @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId                    BigInt                             @map("organization_id") @db.UnsignedBigInt
  baseCurrencyId                    BigInt                             @map("base_currency_id") @db.UnsignedBigInt
  code                              String                             @default(uuid()) @db.VarChar(80)
  name                              String                             @db.VarChar(200)
  timezone                          String                             @db.VarChar(64)
  isActive                          Boolean                            @default(true) @map("is_active")
  manualJournalMakerCheckerEnabled  Boolean                            @default(true) @map("manual_journal_maker_checker_enabled")
  createdAt                         DateTime                           @default(now()) @map("created_at")
  updatedAt                         DateTime                           @updatedAt @map("updated_at")
  organization                      Organization                       @relation(fields: [organizationId], references: [id])
  baseCurrency                      Currency                           @relation("BaseCurrency", fields: [baseCurrencyId], references: [id])
  ownedCurrencies                   Currency[]                         @relation("OwnedCurrencies")
  assignments                       UserCompany[]
  sessions                          Session[]
  idempotency                       IdempotencyRecord[]
  roles                             Role[]
  auditLogs                         AuditLog[]
  securityEvents                    SecurityEvent[]
  fiscalYears                       FiscalYear[]
  fiscalPeriods                     FiscalPeriod[]
  documentSequences                 DocumentSequence[]
  masterDataCodeSequences           MasterDataCodeSequence[]
  accountingDocuments               AccountingDocument[]
  journalEntries                    JournalEntry[]
  journalLines                      JournalLine[]
  accounts                          Account[]
  costCenters                       CostCenter[]
  customers                         Customer[]
  customerAddresses                 CustomerAddress[]
  cashBankAccounts                  CashBankAccount[]
  warehouses                        Warehouse[]
  unitsOfMeasure                    UnitOfMeasure[]
  inventoryItems                    InventoryItem[]
  inventoryMovementSequence         InventoryMovementSequence?
  inventoryMovements                InventoryMovement[]
  inventoryMovementLines            InventoryMovementLine[]
  inventoryBalances                 InventoryBalance[]
  inventoryValuationInitializations InventoryValuationInitialization[]
  paymentMethods                    PaymentMethod[]
  receipts                          Receipt[]
  receiptAllocations                ReceiptAllocation[]
  receivableItems                   ReceivableItem[]
  suppliers                         Supplier[]
  supplierAddresses                 SupplierAddress[]
  payments                          Payment[]
  paymentAllocations                PaymentAllocation[]
  payableItems                      PayableItem[]
  taxRates                          TaxRate[]
  salesInvoices                     SalesInvoice[]
  salesInvoiceLines                 SalesInvoiceLine[]
  purchaseInvoices                  PurchaseInvoice[]
  purchaseInvoiceLines              PurchaseInvoiceLine[]
  documentPrintArchives             DocumentPrintArchive[]
  companyCurrencies                 CompanyCurrency[]
  registrationRequests              RegistrationRequest[]              @relation("RegistrationCompany")
  dataImportBatches                 DataImportBatch[]
  bankStatementImports              BankStatementImport[]
  bankStatementLines                BankStatementLine[]
  bankReconciliationSessions        BankReconciliationSession[]
  bankReconciliationMatches         BankReconciliationMatch[]
  financialCloseRuns                FinancialCloseRun[]
  approvalRequests                  ApprovalRequest[]
  approvalDecisions                 ApprovalDecision[]
  cashFlowAccountMappings           CashFlowAccountMapping[]
  posSales                          PosSale[]
  professionalProjects              ProfessionalProject[]
  professionalProjectMembers        ProfessionalProjectMember[]
  professionalTimeEntries           ProfessionalTimeEntry[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("companies")
}

model User {
  id                                BigInt                             @id @default(autoincrement()) @db.UnsignedBigInt
  emailNormalized                   String                             @unique @map("email_normalized") @db.VarChar(320)
  passwordHash                      String                             @map("password_hash") @db.VarChar(255)
  displayName                       String                             @map("display_name") @db.VarChar(160)
  nameEn                            String?                            @map("name_en") @db.VarChar(160)
  isActive                          Boolean                            @default(true) @map("is_active")
  failedLoginAttempts               Int                                @default(0) @map("failed_login_attempts") @db.UnsignedTinyInt
  lockedUntil                       DateTime?                          @map("locked_until")
  lastLoginAt                       DateTime?                          @map("last_login_at")
  createdAt                         DateTime                           @default(now()) @map("created_at")
  updatedAt                         DateTime                           @updatedAt @map("updated_at")
  assignments                       UserCompany[]
  sessions                          Session[]
  idempotency                       IdempotencyRecord[]
  auditLogs                         AuditLog[]
  securityEvents                    SecurityEvent[]                    @relation("SecurityEventUser")
  securityEventsAcknowledged        SecurityEvent[]                    @relation("SecurityEventAcknowledgedBy")
  periodsClosed                     FiscalPeriod[]                     @relation("PeriodClosedBy")
  periodsReopened                   FiscalPeriod[]                     @relation("PeriodReopenedBy")
  documentsCreated                  AccountingDocument[]               @relation("DocumentCreatedBy")
  documentsPosted                   AccountingDocument[]               @relation("DocumentPostedBy")
  printArchivesCreated              DocumentPrintArchive[]             @relation("PrintArchiveCreatedBy")
  exchangeRatesUpdated              CompanyExchangeRate[]              @relation("ExchangeRateUpdatedBy")
  registrationRequests              RegistrationRequest[]              @relation("RegistrationUser")
  passwordResetRequests             PasswordResetRequest[]
  dataImportBatches                 DataImportBatch[]                  @relation("DataImportCreatedBy")
  inventoryMovementsCreated         InventoryMovement[]                @relation("InventoryMovementCreatedBy")
  inventoryValuationsCreated        InventoryValuationInitialization[] @relation("InventoryValuationCreatedBy")
  bankStatementImportsCreated       BankStatementImport[]              @relation("BankStatementImportCreatedBy")
  bankStatementLinesClassified      BankStatementLine[]                @relation("BankStatementLineClassifiedBy")
  bankReconciliationSessionsCreated BankReconciliationSession[]        @relation("BankReconciliationSessionCreatedBy")
  bankReconciliationSessionsClosed  BankReconciliationSession[]        @relation("BankReconciliationSessionClosedBy")
  bankReconciliationMatchesApproved BankReconciliationMatch[]          @relation("BankReconciliationMatchApprovedBy")
  bankReconciliationMatchesReleased BankReconciliationMatch[]          @relation("BankReconciliationMatchReleasedBy")
  financialCloseRunsStarted         FinancialCloseRun[]                @relation("FinancialCloseRunStartedBy")
  financialCloseRunsReviewed        FinancialCloseRun[]                @relation("FinancialCloseRunReviewedBy")
  financialCloseRunsReturned        FinancialCloseRun[]                @relation("FinancialCloseRunReturnedBy")
  financialCloseRunsClosed          FinancialCloseRun[]                @relation("FinancialCloseRunClosedBy")
  approvalRequestsCreated           ApprovalRequest[]                  @relation("ApprovalRequestCreatedBy")
  approvalDecisionsMade             ApprovalDecision[]                 @relation("ApprovalDecisionMadeBy")
  cashFlowMappingsCreated           CashFlowAccountMapping[]           @relation("CashFlowMappingCreatedBy")
  cashFlowMappingsUpdated           CashFlowAccountMapping[]           @relation("CashFlowMappingUpdatedBy")
  posSalesCompleted                 PosSale[]                          @relation("PosSaleCompletedBy")
  professionalProjectsCreated       ProfessionalProject[]              @relation("ProfessionalProjectCreatedBy")
  professionalProjectsUpdated       ProfessionalProject[]              @relation("ProfessionalProjectUpdatedBy")
  professionalMembersAssigned       ProfessionalProjectMember[]        @relation("ProfessionalProjectMemberAssignedBy")
  professionalMembersUpdated        ProfessionalProjectMember[]        @relation("ProfessionalProjectMemberUpdatedBy")

  @@map("users")
}

model RegistrationRequest {
  id                        BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  publicId                  String                     @unique @default(uuid()) @map("public_id") @db.VarChar(80)
  emailNormalized           String                     @unique @map("email_normalized") @db.VarChar(320)
  passwordHash              String?                    @map("password_hash") @db.VarChar(255)
  displayName               String                     @map("display_name") @db.VarChar(160)
  organizationName          String                     @map("organization_name") @db.VarChar(200)
  companyName               String                     @map("company_name") @db.VarChar(200)
  timezone                  String                     @db.VarChar(64)
  baseCurrencyCode          String                     @map("base_currency_code") @db.Char(3)
  locale                    String                     @default("ar") @db.VarChar(10)
  chartTemplateCode         String                     @default("SMALL_BUSINESS_GENERAL") @map("chart_template_code") @db.VarChar(80)
  verificationTokenHash     Bytes                      @unique @map("verification_token_hash") @db.Binary(32)
  verificationExpiresAt     DateTime                   @map("verification_expires_at")
  status                    RegistrationStatus         @default(PENDING_EMAIL)
  deliveryStatus            RegistrationDeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryAttempts          Int                        @default(0) @map("delivery_attempts") @db.UnsignedSmallInt
  deliveryGeneration        Int                        @default(1) @map("delivery_generation") @db.UnsignedSmallInt
  verifiedAt                DateTime?                  @map("verified_at")
  provisioningStartedAt     DateTime?                  @map("provisioning_started_at")
  completedAt               DateTime?                  @map("completed_at")
  provisionedOrganizationId BigInt?                    @map("provisioned_organization_id") @db.UnsignedBigInt
  provisionedCompanyId      BigInt?                    @map("provisioned_company_id") @db.UnsignedBigInt
  provisionedUserId         BigInt?                    @map("provisioned_user_id") @db.UnsignedBigInt
  lastErrorCode             String?                    @map("last_error_code") @db.VarChar(80)
  initialIpAddress          String?                    @map("initial_ip_address") @db.VarChar(64)
  initialUserAgent          String?                    @map("initial_user_agent") @db.VarChar(500)
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  provisionedOrganization   Organization?              @relation("RegistrationOrganization", fields: [provisionedOrganizationId], references: [id], onDelete: SetNull)
  provisionedCompany        Company?                   @relation("RegistrationCompany", fields: [provisionedCompanyId], references: [id], onDelete: SetNull)
  provisionedUser           User?                      @relation("RegistrationUser", fields: [provisionedUserId], references: [id], onDelete: SetNull)
  events                    RegistrationEvent[]

  @@index([status, verificationExpiresAt])
  @@index([provisionedCompanyId])
  @@index([provisionedUserId])
  @@map("registration_requests")
}

model RegistrationEvent {
  id                    BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  registrationRequestId BigInt?              @map("registration_request_id") @db.UnsignedBigInt
  emailHash             Bytes                @map("email_hash") @db.Binary(32)
  eventType             String               @map("event_type") @db.VarChar(80)
  severity              SecuritySeverity
  ipAddress             String?              @map("ip_address") @db.VarChar(64)
  userAgent             String?              @map("user_agent") @db.VarChar(500)
  details               Json?
  createdAt             DateTime             @default(now()) @map("created_at")
  registrationRequest   RegistrationRequest? @relation(fields: [registrationRequestId], references: [id], onDelete: Cascade)

  @@index([registrationRequestId, createdAt])
  @@index([emailHash, createdAt])
  @@index([severity, createdAt])
  @@map("registration_events")
}

model PasswordResetRequest {
  id                 BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  publicId           String                     @unique @default(uuid()) @map("public_id") @db.VarChar(80)
  userId             BigInt                     @map("user_id") @db.UnsignedBigInt
  locale             String                     @default("ar") @db.VarChar(10)
  tokenHash          Bytes?                     @unique @map("token_hash") @db.Binary(32)
  expiresAt          DateTime?                  @map("expires_at")
  status             PasswordResetStatus        @default(PENDING)
  deliveryStatus     RegistrationDeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryAttempts   Int                        @default(0) @map("delivery_attempts") @db.UnsignedSmallInt
  lastErrorCode      String?                    @map("last_error_code") @db.VarChar(80)
  requestedIpAddress String?                    @map("requested_ip_address") @db.VarChar(64)
  requestedUserAgent String?                    @map("requested_user_agent") @db.VarChar(500)
  usedAt             DateTime?                  @map("used_at")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  user               User                       @relation(fields: [userId], references: [id])

  @@index([userId, status, createdAt])
  @@index([status, expiresAt])
  @@map("password_reset_requests")
}

model OutboxEvent {
  id            BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  eventId       String       @unique @default(uuid()) @map("event_id") @db.Char(36)
  eventType     String       @map("event_type") @db.VarChar(100)
  schemaVersion Int          @default(1) @map("schema_version") @db.UnsignedSmallInt
  aggregateType String       @map("aggregate_type") @db.VarChar(80)
  aggregateId   String       @map("aggregate_id") @db.VarChar(80)
  companyId     BigInt?      @map("company_id") @db.UnsignedBigInt
  payload       Json
  occurredAt    DateTime     @default(now()) @map("occurred_at")
  status        OutboxStatus @default(PENDING)
  availableAt   DateTime     @default(now()) @map("available_at")
  attemptCount  Int          @default(0) @map("attempt_count") @db.UnsignedSmallInt
  maxAttempts   Int          @default(8) @map("max_attempts") @db.UnsignedSmallInt
  lockedAt      DateTime?    @map("locked_at")
  lockToken     String?      @map("lock_token") @db.Char(36)
  lastErrorCode String?      @map("last_error_code") @db.VarChar(80)
  lastErrorAt   DateTime?    @map("last_error_at")
  processedAt   DateTime?    @map("processed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([status, availableAt, id])
  @@index([status, lockedAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([processedAt])
  @@map("outbox_events")
}

model DataImportBatch {
  id            BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  publicId      String           @unique @default(uuid()) @map("public_id") @db.Char(36)
  companyId     BigInt           @map("company_id") @db.UnsignedBigInt
  createdById   BigInt           @map("created_by_id") @db.UnsignedBigInt
  importType    DataImportType   @map("import_type")
  sourceFormat  DataImportFormat @map("source_format")
  fileHash      Bytes            @map("file_hash") @db.Binary(32)
  rowCount      Int              @map("row_count") @db.UnsignedSmallInt
  validRowCount Int              @map("valid_row_count") @db.UnsignedSmallInt
  errorRowCount Int              @map("error_row_count") @db.UnsignedSmallInt
  status        DataImportStatus @default(PREVIEWED)
  expiresAt     DateTime         @map("expires_at")
  committedAt   DateTime?        @map("committed_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy     User             @relation("DataImportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([companyId, status, createdAt])
  @@index([createdById, createdAt])
  @@index([status, expiresAt])
  @@map("data_import_batches")
}

model BankStatementImport {
  id                     BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  publicId               String                     @unique @default(uuid()) @map("public_id") @db.Char(36)
  companyId              BigInt                     @map("company_id") @db.UnsignedBigInt
  cashBankAccountId      BigInt                     @map("cash_bank_account_id") @db.UnsignedBigInt
  createdById            BigInt                     @map("created_by_id") @db.UnsignedBigInt
  format                 BankStatementFormat
  sourceHashSha256       Bytes                      @map("source_hash_sha256") @db.Binary(32)
  statementId            String?                    @map("statement_id") @db.VarChar(120)
  accountIdentifierLast4 String?                    @map("account_identifier_last4") @db.VarChar(4)
  currencyCode           String                     @map("currency_code") @db.Char(3)
  periodStart            DateTime                   @map("period_start") @db.Date
  periodEnd              DateTime                   @map("period_end") @db.Date
  openingBalance         Decimal?                   @map("opening_balance") @db.Decimal(19, 4)
  closingBalance         Decimal?                   @map("closing_balance") @db.Decimal(19, 4)
  netMovement            Decimal                    @map("net_movement") @db.Decimal(19, 4)
  lineCount              Int                        @map("line_count") @db.UnsignedSmallInt
  ignoredEntryCount      Int                        @default(0) @map("ignored_entry_count") @db.UnsignedSmallInt
  status                 BankStatementImportStatus  @default(COMMITTED)
  version                Int                        @default(0) @db.UnsignedInt
  committedAt            DateTime                   @default(now()) @map("committed_at")
  cancelledAt            DateTime?                  @map("cancelled_at")
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")
  company                Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cashBankAccount        CashBankAccount            @relation(fields: [cashBankAccountId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  createdBy              User                       @relation("BankStatementImportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines                  BankStatementLine[]
  reconciliationSession  BankReconciliationSession?

  @@unique([id, companyId])
  @@unique([companyId, cashBankAccountId, sourceHashSha256], map: "bank_statement_imports_company_account_hash_key")
  @@index([companyId, status, committedAt])
  @@index([createdById, createdAt])
  @@map("bank_statement_imports")
}

model BankStatementLine {
  id                 BigInt                           @id @default(autoincrement()) @db.UnsignedBigInt
  companyId          BigInt                           @map("company_id") @db.UnsignedBigInt
  statementImportId  BigInt                           @map("statement_import_id") @db.UnsignedBigInt
  sourceRowNumber    Int                              @map("source_row_number") @db.UnsignedSmallInt
  bookingDate        DateTime                         @map("booking_date") @db.Date
  valueDate          DateTime?                        @map("value_date") @db.Date
  amount             Decimal                          @db.Decimal(19, 4)
  currencyCode       String                           @map("currency_code") @db.Char(3)
  fingerprintSha256  Bytes                            @map("fingerprint_sha256") @db.Binary(32)
  externalId         String?                          @map("external_id") @db.VarChar(160)
  reference          String?                          @db.VarChar(160)
  description        String?                          @db.VarChar(500)
  classification     BankStatementLineClassification?
  classificationNote String?                          @map("classification_note") @db.VarChar(500)
  classifiedById     BigInt?                          @map("classified_by_id") @db.UnsignedBigInt
  classifiedAt       DateTime?                        @map("classified_at")
  version            Int                              @default(0) @db.UnsignedInt
  createdAt          DateTime                         @default(now()) @map("created_at")
  company            Company                          @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  statementImport    BankStatementImport              @relation(fields: [statementImportId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  classifiedBy       User?                            @relation("BankStatementLineClassifiedBy", fields: [classifiedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  matches            BankReconciliationMatch[]

  @@unique([id, companyId])
  @@unique([statementImportId, sourceRowNumber])
  @@index([companyId, bookingDate, id])
  @@index([companyId, fingerprintSha256])
  @@index([classifiedById, classifiedAt])
  @@map("bank_statement_lines")
}

model BankReconciliationSession {
  id                 BigInt                          @id @default(autoincrement()) @db.UnsignedBigInt
  publicId           String                          @unique @default(uuid()) @map("public_id") @db.Char(36)
  companyId          BigInt                          @map("company_id") @db.UnsignedBigInt
  cashBankAccountId  BigInt                          @map("cash_bank_account_id") @db.UnsignedBigInt
  statementImportId  BigInt                          @map("statement_import_id") @db.UnsignedBigInt
  dateFrom           DateTime                        @map("date_from") @db.Date
  dateTo             DateTime                        @map("date_to") @db.Date
  currencyCode       String                          @map("currency_code") @db.Char(3)
  bankOpeningBalance Decimal?                        @map("bank_opening_balance") @db.Decimal(19, 4)
  bankClosingBalance Decimal?                        @map("bank_closing_balance") @db.Decimal(19, 4)
  bankNetMovement    Decimal                         @map("bank_net_movement") @db.Decimal(19, 4)
