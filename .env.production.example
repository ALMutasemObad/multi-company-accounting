NODE_ENV=production
APP_NAME=النظام المحاسبي متعدد الشركات
# Values prefixed with VITE_ are embedded when the web app is built.
VITE_APP_NAME=النظام المحاسبي متعدد الشركات
VITE_APP_SHORT_NAME=منصة المحاسبة
VITE_APP_MARK=م
PORT=3000
# Runtime identity only: grant SELECT, INSERT, UPDATE, and DELETE on this schema.
# Never place MIGRATION_DATABASE_URL in Passenger, CloudLinux, or this runtime file.
DATABASE_URL=mysql://runtime_user:replace_with_secret@127.0.0.1:3306/mcap_finance
# Per-process starting baselines only. Validate total connections across all Passenger workers and tune from measured saturation/latency.
DATABASE_POOL_CONNECTION_LIMIT=10
DATABASE_POOL_MIN_IDLE=1
DATABASE_POOL_ACQUIRE_TIMEOUT_MS=10000
DATABASE_CONNECT_TIMEOUT_MS=1000
DATABASE_POOL_IDLE_TIMEOUT_SECONDS=1800
# Comma-separated existing global User BIGINT IDs. Empty disables Platform Operations safely.
# Resolve and approve these identities out of band; production never accepts email-based fallback.
PLATFORM_OPERATOR_USER_IDS=
PLATFORM_PAYMENT_PROVIDER_MODE=disabled
WEB_ORIGIN=https://finance.example.com
SESSION_COOKIE_SECURE=true
PRE_AUTH_TTL_MINUTES=10
SESSION_TTL_HOURS=12
TRUST_PROXY=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
RATE_LIMIT_NETWORK_MULTIPLIER=10
RATE_LIMIT_IDENTITY_SECRET=replace_with_a_stable_random_secret_of_at_least_32_characters
SELF_REGISTRATION_ENABLED=true
REGISTRATION_RATE_LIMIT_MAX=5
REGISTRATION_TOKEN_TTL_HOURS=24
REGISTRATION_EMAIL_MODE=resend
REGISTRATION_EMAIL_FROM=accounts@example.com
RESEND_API_KEY=re_replace_with_secret_manager_value
REGISTRATION_AUDIT_PEPPER=replace_with_a_separate_random_secret_of_at_least_32_characters
REGISTRATION_TOKEN_SECRET=replace_with_another_separate_random_secret_of_at_least_32_characters
# Keep disabled until the Resend settings and REGISTRATION_TOKEN_SECRET above are configured.
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_RATE_LIMIT_MAX=5
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Enable per rollout approval after migrations and backend gates pass; phase 2 adds no UI.
BANK_RECONCILIATION_ENABLED=false
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_LEASE_MS=30000
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BASE_BACKOFF_MS=1000
OUTBOX_HANDLER_TIMEOUT_MS=8000
OUTBOX_RETENTION_DAYS=30
READINESS_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000
LOG_REQUESTS=true
HTTP_REQUEST_TIMEOUT_MS=70000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
API_READ_DEADLINE_MS=10000
API_WRITE_DEADLINE_MS=15000
API_REGISTRATION_WRITE_DEADLINE_MS=65000
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=replace_with_a_separate_random_metrics_secret_of_at_least_32_characters
ALERT_WINDOW_MS=300000
ALERT_MIN_TRANSACTION_SAMPLES=20
ALERT_DEADLOCK_RATIO_THRESHOLD=0.05
ALERT_RETRY_EXHAUSTED_RATIO_THRESHOLD=0.02
ALERT_REQUEST_DEADLINE_COUNT_THRESHOLD=5
ALERT_OUTBOX_LAG_MS_THRESHOLD=60000
ALERT_OUTBOX_DEAD_LETTER_COUNT_THRESHOLD=1
ALERT_COOLDOWN_MS=300000
BACKUP_DIRECTORY=/var/backups/mcap
BACKUP_ENCRYPTION_PASSPHRASE=replace_with_secret_manager_value_of_at_least_32_characters
MYSQL_BIN=/usr/bin/mysql
MYSQLDUMP_BIN=/usr/bin/mysqldump
